<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.angel.curso.javafx.chatapp.appjavafxchat.controllers.ChatController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <HBox spacing="10">
        <TextField fx:id="usernameField" promptText="Tu Username..."/>
        <Button fx:id="connectButton" text="Conectar"/>
    </HBox>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" prefHeight="250">
        <VBox fx:id="chatBox" spacing="5"/>
    </ScrollPane>

    <HBox spacing="10">
        <TextField fx:id="messageField" promptText="Escribe un mensaje..."/>
        <Button fx:id="sendButton" text="Enviar"/>
        <Button fx:id="disconnectButton" text="Cerrar Chat"/>
    </HBox>

    <Label fx:id="writingLabel" textFill="gray"/>
</VBox>
